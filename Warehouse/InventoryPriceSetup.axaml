<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Accounting.Warehouse.InventoryPriceSetup">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Установка цен номенклатуры" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Журнал документов установки цен" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button MinWidth="110" Height="40" Classes="accent">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Add" FontSize="16" />
                        <TextBlock Text="Создать" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray" />
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DataGrid Name="PriceSetupGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Width="40">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ui:SymbolIcon Symbol="Attach" FontSize="14" Foreground="Gray"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Дата" Width="130" />
                    <DataGridTextColumn Header="Номер" Width="140" />
                    <DataGridTextColumn Header="Информация" Width="200" />
                    <DataGridTextColumn Header="Ответственный" Width="250" />
                    <DataGridTextColumn Header="Комментарий" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>