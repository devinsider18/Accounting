<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Accounting.returns">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Возвраты товаров от покупателей" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Просмотр и оформление возвратов" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemWidth="260" Margin="0,0,0,15">
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <CheckBox Content="Контрагент:" FontSize="12" Opacity="0.7" MinHeight="20" Margin="0,0,0,-5"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <CheckBox Content="Организация:" FontSize="12" Opacity="0.7" MinHeight="20" Margin="0,0,0,-5"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button MinWidth="140" Height="40" Classes="accent">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Товары" />
                            <MenuItem Header="Отгруженные товары" />
                            <MenuItem Header="Переданные на реализацию" />
                            <MenuItem Header="Выкупленные комиссионером" />
                            <MenuItem Header="Товары на склад комиссионера" />
                            <MenuItem Header="Оборудование" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Add" FontSize="16" />
                        <TextBlock Text="Возврат" />
                    </StackPanel>
                </Button>
                <Button MinWidth="180" Height="40">
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="Выдача наличных" />
                            <MenuItem Header="Корректировка реализации" />
                            <MenuItem Header="Операция по платежной карте" />
                            <MenuItem Header="Отражение начисления НДС" />
                            <MenuItem Header="Отражение НДС к вычету" />
                            <MenuItem Header="Платежное поручение" />
                            <MenuItem Header="Списание с расчетного счета" />
                            <MenuItem Header="Счет-фактура выданный" />
                            <MenuItem Header="Счет-фактура полученный" />
                        </MenuFlyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ui:SymbolIcon Symbol="Copy" FontSize="16" />
                        <TextBlock Text="Создать на основании" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray" />
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DataGrid Name="ReturnsGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="120" />
                    <DataGridTextColumn Header="Контрагент" Width="200" />
                    <DataGridTextColumn Header="Сумма" Width="110" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Вид операции" Width="140" />
                    <DataGridTextColumn Header="Склад" Width="120" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridTextColumn Header="Ответственный" Width="180" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="4" Margin="0,15,0,0" Padding="15,12" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="Итоги за период" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Всего документов:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>