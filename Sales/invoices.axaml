<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Accounting.Invoices">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Счета покупателям" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Управление счетами на оплату и контроль задолженности" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <StackPanel Width="260" Spacing="5" Margin="0,0,0,10">
                <TextBlock Text="Контрагент:" FontSize="12" Opacity="0.7"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Width="260" Spacing="5" Margin="0,0,0,10">
                <TextBlock Text="Организация:" FontSize="12" Opacity="0.7"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Создать" Classes="accent" MinWidth="140" Height="40">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add" FontSize="16"/>
                                    <TextBlock Text="Создать" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button MinWidth="240" Height="40">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="CloudDownload" FontSize="16"/>
                                    <TextBlock Text="Загрузить из интернет-магазина" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button MinWidth="180" Height="40">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Оказание производственных услуг" />
                                <MenuItem Header="Операция по платежной карте" />
                                <MenuItem Header="Поступление на расчетный счет" />
                                <MenuItem Header="Поступление наличных" />
                                <MenuItem Header="Реализация (акт, накладная)" />
                                <MenuItem Header="Розничная продажа (чек)" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Copy" FontSize="16"/>
                                    <TextBlock Text="Создать на основании" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button MinWidth="160" Height="40">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Sync" FontSize="16"/>
                                    <TextBlock Text="Изменить статус" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="3"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="InvoicesGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="120" />
                    <DataGridTextColumn Header="Контрагент" Width="200" />
                    <DataGridTextColumn Header="Сумма" Width="110" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Срок оплаты" Width="120" />
                    <DataGridTextColumn Header="Оплата" Width="120" />
                    <DataGridTextColumn Header="Отгрузка" Width="120" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridTextColumn Header="Ответственный" Width="180" />
                    <DataGridTextColumn Header="Комментарий" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
