<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Accounting.Sales.Implementation">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Реализация (акты, накладные, УПД)" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Оформление продажи товаров и услуг" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemWidth="260" Margin="0,0,0,15">
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <TextBlock Text="Контрагент:" FontSize="12" Opacity="0.7"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <TextBlock Text="Организация:" FontSize="12" Opacity="0.7"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button MinWidth="140" Height="40" Classes="accent">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Товары (накладная, УПД)" />
                                <MenuItem Header="Услуги (акт, УПД)" />
                                <MenuItem Header="Строительные работы" />
                                <MenuItem Header="Товары и услуги" />
                                <MenuItem Header="Передача на реализацию" />
                                <MenuItem Header="Выкуп комиссионером" />
                                <MenuItem Header="Продажа со склада комиссионера" />
                                <MenuItem Header="Отгрузка без перехода права собственности" />
                                <MenuItem Header="Оборудование" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Add" FontSize="16" />
                                    <TextBlock Text="Реализация" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button MinWidth="180" Height="40">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Акт о расхождениях (полученный)" />
                                <MenuItem Header="Возврат товаров от покупателя" />
                                <MenuItem Header="Заявление о ввозе товаров (полученное)" />
                                <MenuItem Header="Корректировка реализации" />
                                <MenuItem Header="Операция по платежной карте" />
                                <MenuItem Header="Отражение начисления НДС" />
                                <MenuItem Header="Отчет комиссионера (агента)" />
                                <MenuItem Header="Передача задолженности на факторинг" />
                                <MenuItem Header="Поступление на расчетный счет" />
                                <MenuItem Header="Поступление наличных" />
                                <MenuItem Header="Реализация отгруженных товаров" />
                                <MenuItem Header="Статистическая форма учета перемещения товаров" />
                                <MenuItem Header="Счет покупателю" />
                                <MenuItem Header="Счет-фактура выданный" />
                                <MenuItem Header="Таможенная декларация (экспорт)" />
                                <MenuItem Header="Уведомление о перемещении прослеживаемых товаров в ЕАЭС" />
                            </MenuFlyout>
                        </Button.Flyout>
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Copy" FontSize="16" />
                                    <TextBlock Text="Создать на основании" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                    <Button MinWidth="120" Height="40">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Accept" FontSize="16" />
                                    <TextBlock Text="Подписан" />
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>
                </StackPanel>
            </ScrollViewer>

            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray" />
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="3"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="ImplementationGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="120" />
                    <DataGridTextColumn Header="Контрагент" Width="200" />
                    <DataGridTextColumn Header="Сумма" Width="110" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Счет-фактура" Width="120" />
                    <DataGridTextColumn Header="№ СФ/УПД" Width="120" />
                    <DataGridTextColumn Header="Склад" Width="120" />
                    <DataGridTextColumn Header="Вид операции" Width="140" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridTextColumn Header="Подписан" Width="90" />
                    <DataGridTextColumn Header="Ответственный" Width="180" />
                    <DataGridTextColumn Header="Комментарий" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
