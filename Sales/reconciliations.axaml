<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Accounting.reconciliations">
    <Grid RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Акты сверки расчетов с контрагентами" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Сверка взаиморасчетов и контроль задолженности" 
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <WrapPanel Grid.Row="1" Orientation="Horizontal" ItemWidth="300" Margin="0,0,0,15">
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <CheckBox Content="Контрагент:" FontSize="12" Opacity="0.7" MinHeight="20" Margin="0,0,0,-5"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="5" Margin="0,0,15,10">
                <CheckBox Content="Организация:" FontSize="12" Opacity="0.7" MinHeight="20" Margin="0,0,0,-5"/>
                <ComboBox HorizontalAlignment="Stretch" />
            </StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button MinWidth="110" Height="40" Classes="accent">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Add" FontSize="16" />
                            <TextBlock Text="Создать" />
                        </StackPanel>
                    </Button>
                    <Button MinWidth="110" Height="40">
                         <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Accept" FontSize="16"  />
                            <TextBlock Text="Подписан" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray" />
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}"
                CornerRadius="8" ClipToBounds="True" BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DataGrid Name="ReconciliationGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="120" />
                    <DataGridTextColumn Header="Контрагент" Width="200" />
                    <DataGridTextColumn Header="Договор" Width="150" />
                    <DataGridTextColumn Header="Период" Width="180" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridTextColumn Header="Подписан" Width="90" />
                    <DataGridTextColumn Header="Ответственный" Width="150" />
                    <DataGridTextColumn Header="Комментарий" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="4" Margin="0,15,0,0" Padding="15,12" CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource LayerOnMicaBaseAltFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" >
            <Grid ColumnDefinitions="Auto, *, Auto">
                <TextBlock Grid.Column="0" Text="Итоги за период" FontSize="12" Opacity="0.6" VerticalAlignment="Center"  />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="15,0">
                    <TextBlock Text="Всего документов:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"  />
                    <TextBlock Text="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>