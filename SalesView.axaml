<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Accounting.SalesView">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="30">
            <StackPanel Spacing="5">
                <TextBlock Text="Продажи" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Оформление реализаций, работа с покупателями и контроль задолженности" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                <StackPanel Grid.Column="0" Spacing="15">
                    <TextBlock Text="ОТГРУЗКА И СЧЕТА" FontWeight="Bold" FontSize="14" Foreground="#0078D4" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Mail" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Счета покупателям" FontWeight="Medium"/>
                                <TextBlock Text="Выставление счетов на оплату" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Send" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Реализация (акты, накладные, УПД)" FontWeight="Medium"/>
                                <TextBlock Text="Оформление продажи товаров и услуг" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Library" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Счета-фактуры выданные" FontWeight="Medium"/>
                                <TextBlock Text="Начисление НДС и формирование книги продаж" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Undo" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Возвраты от покупателей" FontWeight="Medium"/>
                                <TextBlock Text="Приемка возвращенного товара" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="15">
                    <TextBlock Text="КОНТРОЛЬ ОПЛАТ" FontWeight="Bold" FontSize="14" Foreground="#107C10" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Sync" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Акты сверки расчетов" FontWeight="Medium"/>
                                <TextBlock Text="Сверка задолженности с клиентами" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Edit" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Корректировка долга" FontWeight="Medium"/>
                                <TextBlock Text="Списание безнадежных долгов и взаимозачеты" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="ОТЧЕТЫ И ЭДО" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="0,15,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Find" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Анализ продаж и долгов" FontWeight="Medium"/>
                                <TextBlock Text="Счета, не оплаченные покупателями" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="List" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Прайс-листы" FontWeight="Medium"/>
                                <TextBlock Text="Управление ценами на товары и услуги" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Link" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Текущие дела ЭДО" FontWeight="Medium"/>
                                <TextBlock Text="Электронный документооборот с покупателями" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>