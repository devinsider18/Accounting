<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Accounting.Operation.OperationView">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="30">
            <StackPanel Spacing="5">
                <TextBlock Text="Операции и Отчеты" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Журналы проводок, закрытие периода, ЕНС и главные отчеты" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                <StackPanel Grid.Column="0" Spacing="15">
                    <TextBlock Text="УЧЕТ И ПЕРИОДЫ" FontWeight="Bold" FontSize="14" Foreground="#881798" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Library" FontSize="24" Foreground="#881798"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Журнал операций" FontWeight="Medium"/>
                                <TextBlock Text="Единый список всех документов и проводок" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="People" FontSize="24" Foreground="#881798"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Начисление дивидендов" FontWeight="Medium"/>
                                <TextBlock Text="Расчет и начисление дивидендов учредителям" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="ЗАКРЫТИЕ ПЕРИОДА" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="0,15,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Calendar" FontSize="24" Foreground="#881798"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Закрытие месяца" FontWeight="Medium"/>
                                <TextBlock Text="Расчет амортизации, налогов и фиксация прибыли" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="15">
                    <TextBlock Text="НАЛОГИ И ЕНС" FontWeight="Bold" FontSize="14" Foreground="#00B294" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Calculator" FontSize="24" Foreground="#00B294"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Единый налоговый счет (ЕНС)" FontWeight="Medium"/>
                                <TextBlock Text="Уведомления, заявления и расчеты с бюджетом" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Tag" FontSize="24" Foreground="#00B294"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Регламентные операции НДС" FontWeight="Medium"/>
                                <TextBlock Text="Формирование книги покупок и книги продаж" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <TextBlock Text="СТАНДАРТНЫЕ ОТЧЕТЫ" FontWeight="Bold" FontSize="12" Opacity="0.5" Margin="0,15,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Document" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Оборотно-сальдовая ведомость" FontWeight="Medium"/>
                                <TextBlock Text="Главный отчет по всем счетам и остаткам (ОСВ)" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Find" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Анализ счета" FontWeight="Medium"/>
                                <TextBlock Text="Детализация оборотов выбранного счета" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>