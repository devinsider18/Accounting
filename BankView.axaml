<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="650"
             x:Class="Calculus.BankView">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="30">
            <StackPanel Spacing="5">
                <TextBlock Text="Банк и касса" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Учет денежных операций, работа с выписками и кассовая отчетность" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                <StackPanel Grid.Column="0" Spacing="15">
                    <TextBlock Text="БАНК" FontWeight="Bold" FontSize="14" Foreground="#0078D4" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="List" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Банковские выписки" FontWeight="Medium"/>
                                <TextBlock Text="Основной учет по расчетным счетам" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Paymentorders" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Document" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Платежные поручения" FontWeight="Medium"/>
                                <TextBlock Text="Подготовка оплат поставщикам и в бюджет" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="People" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Платежи по реестрам" FontWeight="Medium"/>
                                <TextBlock Text="Зарплатные проекты и массовые выплаты" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="15">
                    <TextBlock Text="КАССА" FontWeight="Bold" FontSize="14" Foreground="#107C10" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Folder" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Кассовые документы" FontWeight="Medium"/>
                                <TextBlock Text="ПКО и РКО (ордера)" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Contact" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Авансовые отчеты" FontWeight="Medium"/>
                                <TextBlock Text="Расчеты с подотчетными лицами" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="70" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="ViewAll" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Операции по платежным картам" FontWeight="Medium"/>
                                <TextBlock Text="Эквайринг и расчеты с банками" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>