<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="Calculus.Advance_reports">
    <Grid RowDefinitions="Auto, Auto, *" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Авансовые отчеты" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel Orientation="Horizontal" Margin="0,5,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,20,10">
                    <CheckBox Content="Подотчетное лицо:" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                    <ComboBox Width="250" VerticalAlignment="Center" PlaceholderText="Выберите сотрудника" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,20,10">
                    <CheckBox Content="Организация:" VerticalAlignment="Center" FontSize="12" Opacity="0.8"/>
                    <ComboBox Width="300" VerticalAlignment="Center" PlaceholderText="Выберите организацию" />
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Создать" Classes="accent" />
                    <DropDownButton Content="Печать">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Авансовый отчет (АО-1)" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <DropDownButton Content="Создать на основании">
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuItem Header="Выдача наличных" />
                                <MenuItem Header="Списание с расчетного счета" />
                                <MenuItem Header="Поступление товаров и услуг" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="10,0,0,0">
                <TextBox Width="200" Watermark="Поиск (Ctrl+F)">
                    <TextBox.InnerRightContent>
                        <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                    </TextBox.InnerRightContent>
                </TextBox>
                <Button Content="Еще" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" 
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="AdvanceReportsGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="120" />
                    <DataGridTextColumn Header="Подотчетное лицо" Width="200" />
                    <DataGridTextColumn Header="Сумма" Width="100" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Склад" Width="120" />
                    <DataGridTextColumn Header="Вид операции" Width="150" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridTextColumn Header="Ответственный" Width="150" />
                    <DataGridTextColumn Header="Комментарий" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>