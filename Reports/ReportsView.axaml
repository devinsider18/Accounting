<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Accounting.Reports.ReportsView">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="30">
            <StackPanel Spacing="5">
                <TextBlock Text="Отчеты и Аналитика" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Внутренняя бухгалтерская отчетность и управленческие показатели" 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                <StackPanel Grid.Column="0" Spacing="15">
                    <TextBlock Text="СТАНДАРТНЫЕ ОТЧЕТЫ" FontWeight="Bold" FontSize="14" Foreground="#0078D4" Margin="0,0,0,5"/>
                    
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Document}" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Оборотно-сальдовая ведомость" FontWeight="Medium"/>
                                <TextBlock Text="Сводный баланс по всем счетам предприятия" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Library}" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ОСВ по счету" FontWeight="Medium"/>
                                <TextBlock Text="Детализация остатков и оборотов по выбранному счету" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.List}" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Карточка счета" FontWeight="Medium"/>
                                <TextBlock Text="Хронологический список всех проводок по счету" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.ViewAll}" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Анализ счета" FontWeight="Medium"/>
                                <TextBlock Text="Взаимодействие выбранного счета с другими счетами" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="15">
                    <TextBlock Text="УПРАВЛЕНЧЕСКАЯ АНАЛИТИКА" FontWeight="Bold" FontSize="14" Foreground="#107C10" Margin="0,0,0,5"/>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.People}" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Взаиморасчеты с контрагентами" FontWeight="Medium"/>
                                <TextBlock Text="Сводка по дебиторской и кредиторской задолженности" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.AllApps}" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Остатки на складах" FontWeight="Medium"/>
                                <TextBlock Text="Физическое количество и себестоимость ТМЦ" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button HorizontalAlignment="Stretch" Height="78" CornerRadius="8">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="{x:Static ui:Symbol.Sync}" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Движение денежных средств" FontWeight="Medium"/>
                                <TextBlock Text="Поступления и выплаты по кассе и банковским счетам" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>