<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="750"
             x:Class="Accounting.Purchases.PurchasesView">
    <ScrollViewer>
        <StackPanel Margin="40" Spacing="30">
            <StackPanel Spacing="5">
                <TextBlock Text="Покупки" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Учет поступлений товаров и услуг, работа с поставщиками и ВЭД"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Separator Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Grid ColumnDefinitions="*, *" ColumnSpacing="40">
                <StackPanel Grid.Column="0" Spacing="15">
                    <TextBlock Text="ПОСТУПЛЕНИЯ" FontWeight="Bold" FontSize="14" Foreground="#0078D4" Margin="0,0,0,5"/>
                    <Button Name="Invoicesfromsuppliers" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Document" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Счета от поставщиков" FontWeight="Medium"/>
                                <TextBlock Text="Входящие счета на оплату" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Admission" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Download" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Поступление (акты, накладные, УПД)" FontWeight="Medium"/>
                                <TextBlock Text="Оприходование товаров и услуг" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Additionalexpenses" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Calculator" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Поступление доп. расходов" FontWeight="Medium"/>
                                <TextBlock Text="Учет доставки и пошлин в себестоимости" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="InvoicesReceived" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Library" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Счета-фактуры полученные" FontWeight="Medium"/>
                                <TextBlock Text="Книга покупок и вычеты по НДС" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Returnstosuppliers" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Undo" FontSize="24" Foreground="#0078D4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Возвраты поставщикам" FontWeight="Medium"/>
                                <TextBlock Text="Оформление возврата брака или излишков" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="15">
                    <TextBlock Text="РАСЧЕТЫ С КОНТРАГЕНТАМИ" FontWeight="Bold" FontSize="14" Foreground="#107C10" Margin="0,0,0,5"/>
                    <Button Name="ReconciliationStatementswithCounterparties" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Sync" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Акты сверки расчетов" FontWeight="Medium"/>
                                <TextBlock Text="Сверка взаиморасчетов с поставщиками" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Debtadjustment" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Edit" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Корректировка долга" FontWeight="Medium"/>
                                <TextBlock Text="Взаимозачеты и перенос задолженности" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Trusts" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="ContactInfo" FontSize="24" Foreground="#107C10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Доверенности" FontWeight="Medium"/>
                                <TextBlock Text="Выдача доверенностей на получение ТМЦ" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <Button Name="Customsdeclarations" HorizontalAlignment="Stretch" Height="70" CornerRadius="8" Click="Menu">
                        <StackPanel Orientation="Horizontal" Spacing="15">
                            <ui:SymbolIcon Symbol="Globe" FontSize="24"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Таможенные декларации" FontWeight="Medium"/>
                                <TextBlock Text="Учет ГТД и таможенных пошлин" FontSize="11" Opacity="0.6"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>