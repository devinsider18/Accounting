<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Accounting.Purchases.InvoicesFromSuppliers">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Счета от поставщиков" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel Orientation="Horizontal" ItemWidth="250" Margin="0,5,0,0">
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Контрагент:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Выберите контрагента" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Организация:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Выберите организацию" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Период:" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, 10, *">
                        <CalendarDatePicker Grid.Column="0" HorizontalAlignment="Stretch" Watermark="С" />
                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CalendarDatePicker Grid.Column="2" HorizontalAlignment="Stretch" Watermark="По" />
                    </Grid>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="accent" Content="Создать" />
                    <Button Content="Загрузить" />
                    <Button Content="Создать на основании">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Выдача наличных"/>
                                <MenuItem Header="Доверенность"/>
                                <MenuItem Header="Платежное поручение"/>
                                <MenuItem Header="Поступление (акт, накладная, УПД)"/>
                                <MenuItem Header="Списание с расчетного счета"/>
                                <MenuItem Header="Счет покупателю"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Изменить статус" />
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="2" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" 
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="InvoicesGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="100" />
                    <DataGridTextColumn Header="Контрагент" Width="250" />
                    <DataGridTextColumn Header="Сумма" Width="120" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Срок опл." Width="100" />
                    <DataGridTextColumn Header="Оплата" Width="120" />
                    <DataGridTextColumn Header="Поступление" Width="120" />
                    <DataGridTextColumn Header="Организация" Width="200" />
                    <DataGridTextColumn Header="Дата вх." Width="100" />
                    <DataGridTextColumn Header="Номер вх." Width="100" />
                    <DataGridTextColumn Header="Комментарий" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
