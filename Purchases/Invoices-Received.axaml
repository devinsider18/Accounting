<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Accounting.Invoices_Received">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Счета-фактуры полученные" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel Orientation="Horizontal" ItemWidth="250" Margin="0,5,0,0">
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Контрагент:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Организация:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Период:" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, 10, *">
                        <CalendarDatePicker Grid.Column="0" HorizontalAlignment="Stretch" Watermark="С" />
                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CalendarDatePicker Grid.Column="2" HorizontalAlignment="Stretch" Watermark="По" />
                    </Grid>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="+ Создать" Classes="accent" />
                    <Button Content="Создать на основании">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Отражение начисления НДС" />
                                <MenuItem Header="Счет-фактура выданный на аванс комитента" />
                                <MenuItem Header="Корректировочный счет-фактура" />
                                <MenuItem Header="Исправление счета-фактуры" />
                                <MenuItem Header="Исправление собственной ошибки" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Отчеты" />
                    <Button Content="Оригинал" />
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="2" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" 
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="InvoicesReceivedGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Получен" Width="80" />
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="80" />
                    <DataGridTextColumn Header="Сумма" Width="110" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Контрагент" Width="180" />
                    <DataGridTextColumn Header="Вид счета-фактуры" Width="150" />
                    <DataGridTextColumn Header="Организация" Width="180" />
                    <DataGridCheckBoxColumn Header="Оригинал" Width="90" />
                    <DataGridTextColumn Header="Договор" Width="150" />
                    <DataGridTextColumn Header="Документ-основание" Width="220" />
                    <DataGridTextColumn Header="Комментарий" Width="150" />
                    <DataGridTextColumn Header="Ответственный" Width="200" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>