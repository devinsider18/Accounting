<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Accounting.Purchases.AdditionalExpenses">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Поступление доп. расходов" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel Orientation="Horizontal" ItemWidth="250" Margin="0,5,0,0">
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <CheckBox Content="Контрагент:" FontSize="12" Opacity="0.7" IsChecked="False"/>
                    <ComboBox HorizontalAlignment="Stretch"/>
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <CheckBox Content="Организация:" FontSize="12" Opacity="0.7" IsChecked="True"/>
                    <ComboBox HorizontalAlignment="Stretch" SelectedIndex="0">
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Создать" Classes="accent" />
                    <Button Content="Создать на основании">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Выдача наличных" />
                                <MenuItem Header="Платежное поручение" />
                                <MenuItem Header="Списание с расчетного счета" />
                                <MenuItem Header="Корректировка поступления"/>
                                <MenuItem Header="Отражение начисления НДС"/>
                                <MenuItem Header="Отражение НДС к вычету"/>
                                <MenuItem Header="Счет-фактура полученный"/>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>
        <Border Grid.Row="2" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" 
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="AdditionalExpensesGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="100" />
                    <DataGridTextColumn Header="Контрагент" Width="200" />
                    <DataGridTextColumn Header="Сумма" Width="100" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Счет-фактура" Width="120" />
                    <DataGridTextColumn Header="Дата вх." Width="100" />
                    <DataGridTextColumn Header="Номер вх." Width="100" />
                    <DataGridTextColumn Header="Организация" Width="150" />
                    <DataGridTextColumn Header="Оригинал" Width="100" />
                    <DataGridTextColumn Header="Дополнительные документы" Width="200" />
                    <DataGridTextColumn Header="Ответственный" Width="150" />
                    <DataGridTextColumn Header="Комментарий" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>