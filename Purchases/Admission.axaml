<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Accounting.Admission">
    <Grid RowDefinitions="Auto, Auto, *, Auto" Margin="20">
        <StackPanel Grid.Row="0" Spacing="15" Margin="0,0,0,20">
            <TextBlock Text="Поступление (акты, накладные, УПД)" FontSize="24" FontWeight="SemiBold"/>
            <WrapPanel Orientation="Horizontal" ItemWidth="250" Margin="0,5,0,0">
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Контрагент:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Выберите контрагента" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Организация:" FontSize="12" Opacity="0.7"/>
                    <ComboBox HorizontalAlignment="Stretch" PlaceholderText="Выберите организацию" />
                </StackPanel>
                <StackPanel Spacing="5" Margin="0,0,15,10">
                    <TextBlock Text="Период:" FontSize="12" Opacity="0.7"/>
                    <Grid ColumnDefinitions="*, 10, *">
                        <CalendarDatePicker Grid.Column="0" HorizontalAlignment="Stretch" Watermark="С" />
                        <TextBlock Grid.Column="1" Text="-" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <CalendarDatePicker Grid.Column="2" HorizontalAlignment="Stretch" Watermark="По" />
                    </Grid>
                </StackPanel>
            </WrapPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,15">
            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="+ Поступление" Classes="accent">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Товары (накладная, УПД)" />
                                <MenuItem Header="Услуги (акт, УПД)" />
                                <MenuItem Header="Права (акт, УПД)" />
                                <MenuItem Header="Товары, услуги, комиссия" />
                                <MenuItem Header="Основные средства" />
                                <MenuItem Header="Материалы в переработку" />
                                <MenuItem Header="Услуги аренды" />
                                <MenuItem Header="Услуги лизинга" />
                                <MenuItem Header="Оборудование" />
                                <MenuItem Header="Объекты строительства" />
                                <MenuItem Header="Земельные участки" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Content="Загрузить" />
                    <Button Content="Создать на основании">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuItem Header="Таможенная декларация (импорт)" />
                                <MenuItem Header="Установка цен номенклатуры" />
                                <MenuItem Header="Безвозмездная передача" />
                                <MenuItem Header="Возврат товаров поставщику" />
                                <MenuItem Header="Выдача наличных" />
                                <MenuItem Header="Заявление о ввозе товаров" />
                                <MenuItem Header="Корректировка поступления" />
                                <MenuItem Header="Отражение начисления НДС" />
                                <MenuItem Header="Отражение НДС к вычету" />
                                <MenuItem Header="Отчет комитенту" />
                                <MenuItem Header="Передача материалов в эксплуатацию" />
                                <MenuItem Header="Перемещение товаров, материалов" />
                                <MenuItem Header="Платежное поручение" />
                                <MenuItem Header="Поступление доп. расходов" />
                                <MenuItem Header="Расход материалов" />
                                <MenuItem Header="Реализация (акт, накладная, УПД)" />
                                <MenuItem Header="Списание НДС" />
                                <MenuItem Header="Списание с расчетного счета" />
                                <MenuItem Header="Счет покупателю" />
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </ScrollViewer>
            <TextBox Grid.Column="1" Width="250" Watermark="Поиск" Margin="10,0,0,0">
                <TextBox.InnerRightContent>
                    <ui:SymbolIcon Symbol="Find" Margin="0,0,10,0" Foreground="Gray"/>
                </TextBox.InnerRightContent>
            </TextBox>
        </Grid>

        <Border Grid.Row="2" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}" 
                CornerRadius="8" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
            <DataGrid Name="AdmissionGrid" IsReadOnly="True" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Width="100" />
                    <DataGridTextColumn Header="Номер" Width="100" />
                    <DataGridTextColumn Header="Контрагент" Width="250" />
                    <DataGridTextColumn Header="Сумма" Width="120" />
                    <DataGridTextColumn Header="Валюта" Width="80" />
                    <DataGridTextColumn Header="Счет-фактура" Width="120" />
                    <DataGridTextColumn Header="Склад" Width="120" />
                    <DataGridTextColumn Header="Вид операции" Width="150" />
                    <DataGridTextColumn Header="Организация" Width="200" />
                    <DataGridTextColumn Header="Дата вх." Width="100" />
                    <DataGridTextColumn Header="Номер вх." Width="100" />
                    <DataGridTextColumn Header="Оригинал" Width="100" />
                    <DataGridTextColumn Header="Дополнительные документы" Width="150" />
                    <DataGridTextColumn Header="Комментарий" Width="200" />
                    <DataGridTextColumn Header="Ответственный" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="3" Margin="0,15,0,0" Padding="15,12" 
                Background="{DynamicResource LayerOnMicaBaseAltFillColorSecondaryBrush}" 
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto, Auto, Auto">
                <TextBlock Grid.Column="0" Text="Итоги за период" FontSize="12" Opacity="0.6" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="15,0">
                    <TextBlock Text="Всего документов:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="0" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="15,0">
                    <TextBlock Text="Сумма:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="0.00" FontSize="13" FontWeight="SemiBold" Foreground="Green" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" Margin="15,0">
                    <TextBlock Text="Валюта:" FontSize="13" Opacity="0.7" VerticalAlignment="Center"/>
                    <TextBlock Text="РУБ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
